# Smart Resume Screener - Environment Configuration Template

# Database (Default: SQLite for zero-config local run; use PostgreSQL in production/Docker)
DATABASE_URL=sqlite:///./smart_resume_screener.db
# DATABASE_URL=postgresql://screener:screener_password@localhost:5432/smart_resume_screener

# LLM Provider Configuration (OpenAI-compatible)
# Leave empty to automatically use the transparent deterministic fallback engine
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=1
LLM_AUDIT_LOGGING=false

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=15728640

# App Settings
ENVIRONMENT=development
DEBUG=true
